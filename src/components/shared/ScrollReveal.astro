---
/**
 * Drives every `.reveal` element on the page.
 *
 * The `js` class is added by the blocking script in Layout.astro, so elements
 * are hidden before first paint rather than flashing in and out. Without JS
 * they simply stay visible — the reveal is decoration, never a gate on content.
 *
 * Stagger: set `style="--reveal-delay: 80ms"` on the element.
 */
---

<script>
  const THRESHOLD = 0.12;
  const ROOT_MARGIN = "0px 0px -8% 0px";

  let observer: IntersectionObserver | null = null;

  function init() {
    observer?.disconnect();
    const targets = document.querySelectorAll<HTMLElement>(".reveal");

    if (!("IntersectionObserver" in window)) {
      targets.forEach((el) => el.setAttribute("data-revealed", ""));
      return;
    }

    observer = new IntersectionObserver(
      (entries, obs) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.setAttribute("data-revealed", "");
          // One-shot: content that has arrived stays arrived.
          obs.unobserve(entry.target);
        }
      },
      { threshold: THRESHOLD, rootMargin: ROOT_MARGIN },
    );

    targets.forEach((el) => observer!.observe(el));
  }

  document.addEventListener("astro:page-load", init);
  document.addEventListener("astro:before-swap", () => observer?.disconnect());
</script>

<style is:global>
  /* Llega como un material: opacidad, desplazamiento corto y desenfoque
     a la vez, con salida exponencial — sin rebote, nada que distraiga. */
  .js .reveal {
    opacity: 0;
    transform: translate3d(0, 1.75rem, 0);
    filter: blur(8px);
    transition:
      opacity 900ms var(--ease-out-expo),
      transform 1100ms var(--ease-out-expo),
      filter 900ms var(--ease-out-expo);
    transition-delay: var(--reveal-delay, 0ms);
  }

  .js .reveal[data-revealed] {
    opacity: 1;
    transform: none;
    filter: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .js .reveal {
      transform: none;
      filter: none;
      transition: opacity 400ms linear;
    }
  }
</style>
