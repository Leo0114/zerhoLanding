---
import { Image } from "astro:assets";
import Container from "@/components/ui/Container.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import type { ContactInfo } from "@/api/home";
import { IMAGE_ALT, images } from "@/lib/images";

interface Props {
  contact: ContactInfo;
}

const { contact } = Astro.props;
---

<section
  data-surface="dark"
  class="contact-hero relative isolate flex min-h-[72svh] items-end overflow-clip bg-secondary text-white"
>
  <div class="absolute inset-0 -z-20" aria-hidden="true">
    <Image
      src={images.contactHero}
      alt={IMAGE_ALT}
      widths={[640, 1024, 1600, 2400]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="contact-hero-image h-full w-full object-cover"
    />
  </div>
  <div class="contact-hero-scrim absolute inset-0 -z-10" aria-hidden="true"></div>

  <Container class="pb-16 pt-36 sm:pb-20">
    <Eyebrow tone="dark" class="reveal">Contacto</Eyebrow>
    <h1
      class="reveal mt-6 max-w-4xl font-display text-[clamp(2.5rem,6vw,5rem)] font-medium leading-[1] tracking-[-0.02em] text-balance"
      style="--reveal-delay: 80ms"
    >
      {contact.sectionTitle}
    </h1>
    <p
      class="reveal mt-6 max-w-2xl text-[1.0625rem] leading-relaxed text-white/80 text-pretty"
      style="--reveal-delay: 160ms"
    >
      {contact.closingMessage}
    </p>
  </Container>
</section>

<style>
  .contact-hero-scrim {
    background:
      linear-gradient(180deg, rgb(43 42 38 / 0.5) 0%, rgb(43 42 38 / 0) 30%),
      linear-gradient(0deg, rgb(43 42 38 / 0.9) 0%, rgb(43 42 38 / 0.4) 55%, rgb(43 42 38 / 0.1) 100%);
  }

  @media (prefers-reduced-motion: no-preference) {
    .contact-hero :global(.contact-hero-image) {
      animation: settle 1800ms var(--ease-out-expo) both;
    }

    @keyframes settle {
      from {
        transform: scale(1.06);
      }
    }
  }
</style>
