---
import { Image } from "astro:assets";
import firstLogo from "@/assets/firstLogo.png";
import { homeData } from "@/api/home";
import { mailHref, phoneHref, websiteHref } from "@/lib/format";
import { CONTACT_PATH, HOME_SECTIONS, sectionHref } from "@/lib/navigation";

const { contact, hero } = homeData;
const { pathname } = Astro.url;
const year = new Date().getFullYear();
---

<footer data-surface="dark" class="bg-secondary text-darkGray">
  <div class="mx-auto w-full max-w-7xl px-5 pb-10 pt-20 sm:px-8 lg:px-12 lg:pt-24">
    <div class="grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <a href="/" class="footer-brand" aria-label="Zerho Arquitectura — inicio">
          <Image src={firstLogo} alt="" width={640} height={640} widths={[320, 640]} sizes="12rem" />
        </a>
        <p class="mt-6 max-w-sm text-[0.9375rem] leading-relaxed text-darkGray/60">
          {hero.preTitle}. {hero.specialties.join(" · ")}.
        </p>
      </div>

      <nav aria-label="Pie de página" class="lg:col-span-3">
        <p class="footer-heading">Explorar</p>
        <ul class="mt-5 grid gap-3">
          {
            HOME_SECTIONS.map((item) => (
              <li>
                <a href={sectionHref(item.id, pathname)} class="footer-link">
                  {item.label}
                </a>
              </li>
            ))
          }
          <li><a href={CONTACT_PATH} class="footer-link">Contacto</a></li>
        </ul>
      </nav>

      <address class="not-italic lg:col-span-4">
        <p class="footer-heading">Contacto</p>
        <ul class="mt-5 grid gap-3">
          <li class="text-[0.9375rem] text-darkGray">{contact.contactPerson}</li>
          <li><a href={phoneHref(contact.phone)} class="footer-link">{contact.phone}</a></li>
          <li><a href={mailHref(contact.email)} class="footer-link">{contact.email}</a></li>
          <li>
            <a href={websiteHref(contact.website)} class="footer-link" target="_blank" rel="noopener noreferrer">
              {contact.website}
            </a>
          </li>
        </ul>
      </address>
    </div>

    <div class="mt-16 flex flex-col gap-3 border-t border-darkGray/12 pt-8 text-xs text-darkGray/45 sm:flex-row sm:justify-between">
      <p>© {year} Zerho Arquitectura. Todos los derechos reservados.</p>
      <p>Cero sorpresas, por contrato.</p>
    </div>
  </div>
</footer>

<style>
  .footer-brand {
    display: block;
    width: 11rem;
    aspect-ratio: 3 / 1;
    overflow: clip;
    transition: opacity 150ms ease-out;
  }

  .footer-brand:active {
    opacity: 0.7;
  }

  .footer-brand :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .footer-heading {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-warmGray);
  }

  .footer-link {
    font-size: 0.9375rem;
    color: rgb(233 225 209 / 0.65);
    transition: color 300ms var(--ease-out-expo);
  }

  .footer-link:hover {
    color: var(--color-darkGray);
  }
</style>
