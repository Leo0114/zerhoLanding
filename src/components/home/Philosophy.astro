---
import Container from "@/components/ui/Container.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";

/**
 * Propuesta de valor como lectura. Las palabras se encienden al pasar por
 * la pantalla (scroll-driven, sin JS); sin soporte o con movimiento
 * reducido, el texto aparece entero en tinta.
 */
interface Props {
  statement: string;
  specialties: readonly string[];
}

const { statement, specialties } = Astro.props;
const words = statement.split(/\s+/);
---

<section id="filosofia" class="py-28 sm:py-36 lg:py-44">
  <Container class="grid gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="reveal lg:col-span-3">
      <Eyebrow>Nuestra filosofía</Eyebrow>
    </div>

    <div class="lg:col-span-9">
      <p
        class="statement font-display text-[clamp(1.75rem,3.2vw,2.75rem)] font-medium leading-[1.22] tracking-[-0.012em] text-ink"
      >
        {words.map((word) => <span class="word">{word} </span>)}
      </p>

      <ol class="mt-16 grid gap-6 sm:grid-cols-3 sm:gap-8 lg:mt-20">
        {
          specialties.map((specialty, i) => (
            <li
              class="reveal flex items-baseline gap-4 border-t border-ink/12 pt-5 sm:flex-col sm:gap-3"
              style={`--reveal-delay: ${i * 70}ms`}
            >
              <span class="text-xs font-semibold tabular-nums tracking-[0.14em] text-warmGray">
                {String(i + 1).padStart(2, "0")}
              </span>
              <span class="font-display text-[1.75rem] font-medium leading-none tracking-[-0.01em]">
                {specialty}
              </span>
            </li>
          ))
        }
      </ol>
    </div>
  </Container>
</section>

<style>
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .word {
        animation: word-light linear both;
        animation-timeline: view();
        animation-range: entry 100% cover 45%;
      }

      @keyframes word-light {
        from {
          opacity: 0.18;
        }
        to {
          opacity: 1;
        }
      }
    }
  }
</style>
